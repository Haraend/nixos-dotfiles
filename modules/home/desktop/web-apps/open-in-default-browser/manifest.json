{
  "manifest_version": 3,
  "name": "Web app links → default browser",
  "description": "Open outbound http(s) links from Brave --app windows via xdg-open (Zen).",
  "version": "1.0.0",
  "permissions": ["tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*",
        "https://gemini.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://web.whatsapp.com/*",
        "https://gemini.google.com/*"
      ],
      "js": ["main-world.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
